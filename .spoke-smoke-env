# WhisperKit ANE smoke surface
# Pin transcription to WhisperKit medium for this smoke target. Global
# preferences may point elsewhere; launcher smoke should remain self-contained.
export SPOKE_TRANSCRIPTION_MODEL="whisperkit/medium.en"

# Keep WhisperKit warm behind its OpenAI-compatible local server instead of
# paying a fresh CLI process/model setup tax for every dictation.
export SPOKE_WHISPERKIT_RESIDENT="1"

# Keep exact WAVs for WhisperKit-vs-standard replay after bad utterances. This
# target does not force contention mode; the spool is evidence custody only.
export SPOKE_AUDIO_SPOOL_ENABLED="1"

# Preserve the manual Throughglass primitive smoke contract expected by the
# passport tests without auto-opening Throughglass on this transcription target.
export SPOKE_RETINA_LASSO_WATCH_TRACE="1"
export SPOKE_PERCEPTASIA_THROUGHGLASS_SMOKE="0"
export SPOKE_PERCEPTASIA_THROUGHGLASS_REQUIRE_CONTENT_READY="1"
export SPOKE_PERCEPTASIA_THROUGHGLASS_PUBLISH_SHELL="1"
export SPOKE_PERCEPTASIA_THROUGHGLASS_CLICK_THROUGH="0"
export SPOKE_PERCEPTASIA_THROUGHGLASS_URL="http://localhost:8753"
