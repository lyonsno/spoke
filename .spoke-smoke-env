# Smoke env - operator-memory visual baseline
#
# Machine-local secrets are sourced by scripts/launch-main.sh from
# ~/.config/spoke/secrets.env before this file is applied.

# VAD and silence-bounded segment acceleration are deliberately disabled for
# the ASR contention smoke. Final transcription consumes the full raw buffer.
export SPOKE_VAD_ENABLED="0"

# Controlled WhisperKit comparison: keep the model resident, send the full
# capture as one chunk, and move only the encoder onto ANE. The decoder stays
# on CPU so Metal contention cannot stall final decoding.
export SPOKE_TRANSCRIPTION_MODEL="whisperkit/medium.en"
export SPOKE_WHISPERKIT_RESIDENT="1"
export SPOKE_WHISPERKIT_CHUNKING_STRATEGY="none"
export SPOKE_WHISPERKIT_ENCODER_COMPUTE_UNITS="cpuAndNeuralEngine"
export SPOKE_WHISPERKIT_DECODER_COMPUTE_UNITS="cpuOnly"
export SPOKE_WHISPERKIT_TIMEOUT_SECONDS="30"
export SPOKE_WHISPERKIT_TERMINAL_RECOVERY_MODEL="mlx-community/whisper-large-v3-turbo"

# Request the reviewed GPU Greenroom interactive holder as soon as real audio
# capture begins. The holder excludes new Greenroom jobs while effective; it
# does not claim preemption of a running job or control of other Metal clients.
export SPOKE_GPU_INTERACTIVE_LEASE="1"
export SPOKE_GPU_GREENROOM_BINARY="/private/tmp/gpu-greenroom-interactive-asr-lease-0714/.venv/bin/gpu-greenroom"
