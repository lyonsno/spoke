+class FrameRnntEngine : public MockRnntEngine {
+   public:
+    bool silence = false;
+    bool dense = false;
+    std::vector<int> widths;
+    std::vector<int> encode_phrase(const std::string&) const override { return {1}; }
+
+    void joint_argmax(
+        RnntStreamState&, const float* enc, int dim, int T, int32_t* ids,
+        const float* bias = nullptr) override {
+        widths.push_back(T);
+        ++joint_calls;
+        for (int i = 0; i < T; ++i) {
+            const int frame = static_cast<int>(enc[i * dim]);
+            int token = rnnt_config().blank_id;
+            if (dense) {
+                token = 0;
+            } else if (!silence) {
+                if (predictor_calls == 1 && frame == 2)
+                    token = 0;
+                else if (predictor_calls == 2 && frame == 2)
+                    token = 1;
+                else if (predictor_calls == 3 && frame == 5)
+                    token = 2;
+            }
+            ids[i] = bias != nullptr && token == 0 ? 1 : token;
+        }
+    }
+
+    void joint_argmax_device(
+        RnntStreamState& state, const ggml_runtime::DeviceTensor& enc, int offset, int dim, int T,
+        int32_t* ids, const float* bias = nullptr) override {
+        joint_argmax(
+            state, static_cast<const float*>(enc.tensor->data) + offset * dim, dim, T, ids, bias);
+    }
+};
+
+void
+test_rnnt_joint_batches_preserve_state_and_complete_audio() {
+    for (const bool boosted : {false, true}) {
+        std::vector<float> enc(8 * 4, 0.0f);
+        for (int i = 0; i < 8; ++i) enc[i * 4] = static_cast<float>(i);
+        FrameRnntEngine reference;
+        RnntGreedyDecoder full(&reference);
+        AsrRequestOptions opts;
+        opts.enable_word_time_offsets = true;
+        if (boosted) {
+            AsrRequestOptions::Boost context;
+            context.phrases = {"b"};
+            context.boost = 1.0f;
+            opts.speech_contexts.push_back(context);
+        }
+        full.set_request_options(opts);
+        const auto expected = full.step(enc.data(), 4, 8, 10);
+        full.finalize();
+        for (const int width : {1, 2, 3, 8, 32}) {
+            FrameRnntEngine engine;
+            DecoderConfig config;
+            config.rnnt_joint_batch_frames = width;
+            RnntGreedyDecoder tiled(&engine, config);
+            tiled.set_request_options(opts);
+            check(tiled.step(enc.data(), 4, 8, 10) == expected, "rnnt batch: identical tokens");
+            tiled.finalize();
+            check(tiled.last_emit_frame() == full.last_emit_frame(), "rnnt batch: identical clock");
+            check(
+                engine.predictor_calls == reference.predictor_calls, "rnnt batch: predictor cache");
+            check(
+                *std::max_element(engine.widths.begin(), engine.widths.end()) <= width,
+                "rnnt batch: computation width honored");
+            const auto& actual_words = tiled.word_timings();
+            const auto& expected_words = full.word_timings();
+            bool same = actual_words.size() == expected_words.size();
+            for (size_t i = 0; same && i < actual_words.size(); ++i) {
+                same = actual_words[i].word == expected_words[i].word &&
+                       actual_words[i].start_frame == expected_words[i].start_frame &&
+                       actual_words[i].end_frame == expected_words[i].end_frame;
+            }
+            check(same, "rnnt batch: identical word timing");
+            FrameRnntEngine split_engine;
+            RnntGreedyDecoder split(&split_engine, config);
+            split.set_request_options(opts);
+            auto split_ids = split.step(enc.data(), 4, 3, 10);
+            const auto tail_ids = split.step(enc.data() + 3 * 4, 4, 5, 13);
+            split_ids.insert(split_ids.end(), tail_ids.begin(), tail_ids.end());
+            check(
+                split_ids == expected && split.last_emit_frame() == full.last_emit_frame() &&
+                    split_engine.predictor_calls == reference.predictor_calls,
+                "rnnt batch: split-step predictor and token parity");
+
+            // Only the mock reads this carrier; no device backend is created.
+            ggml_tensor tensor{};
+            tensor.buffer = reinterpret_cast<ggml_backend_buffer_t>(1);
+            tensor.data = enc.data();
+            ggml_runtime::DeviceTensor device{
+                &tensor, reinterpret_cast<ggml_backend_buffer_type_t>(1), 0};
+            FrameRnntEngine device_engine;
+            RnntGreedyDecoder device_decoder(&device_engine, config);
+            device_decoder.set_request_options(opts);
+            check(
+                device_decoder.step_device(device, 4, 8, 10) == expected &&
+                    device_engine.predictor_calls == reference.predictor_calls &&
+                    *std::max_element(device_engine.widths.begin(), device_engine.widths.end()) <=
+                        width,
+                "rnnt batch: device/fused host routing parity");
+            if (width == 2) {
+                check(
+                    tiled.stats().joint_frames == (boosted ? 26 : 13),
+                    "rnnt batch: less discarded work");
+            }
+        }
+    }
+
+    FrameRnntEngine silence;
+    silence.silence = true;
+    DecoderConfig config;
+    config.rnnt_joint_batch_frames = 2;
+    RnntGreedyDecoder tiled(&silence, config);
+    std::vector<float> blank(8 * 4, 0.0f);
+    check(tiled.step(blank.data(), 4, 8, 0).empty(), "rnnt batch: full blank tail");
+    check(
+        silence.predictor_calls == 1 && tiled.stats().joint_frames == 8 &&
+            tiled.stats().joint_calls == 4,
+        "rnnt batch: blank tiles advance without recomputing predictor");
+
+    FrameRnntEngine dense;
+    dense.dense = true;
+    config.rnnt_joint_batch_frames = 1;
+    RnntGreedyDecoder dense_decoder(&dense, config);
+    check(
+        dense_decoder.step(blank.data(), 4, 8, 0).size() == 24 &&
+            dense_decoder.stats().encoder_frames == 8,
+        "rnnt batch: max symbols applies independently to every frame");
+    config.rnnt_joint_batch_frames = -1;
+    bool rejected = false;
+    try {
+        RnntGreedyDecoder invalid(&dense, config);
+    }
+    catch (const std::invalid_argument&) {
+        rejected = true;
+    }
+    check(rejected, "rnnt batch: negative computation width rejected");
+}
